DATABASE_URI=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PAYLOAD_SECRET=YOUR_SECRET_HERE
PAYLOAD_FRONTEND_SHARED_SECRET=YOUR_FRONTEND_SHARED_SECRET_FOR_ACCESS_HERE

NEXT_PUBLIC_VERCEL_ENV=YOUR_NEXT_PUBLIC_VERCEL_ENVIRONMENT_HERE
NEXT_PUBLIC_VERCEL_URL=YOUR_NEXT_PUBLIC_VERCEL_URL_HERE

RESEND_API_KEY=RESEND_EMAIL_API_KEY_HERE

BLOB_DEV_READ_WRITE_TOKEN=VERCEL_BLOB_DEV_API_TOKEN_HERE

COOKIE_PREFIX=HTTP_COOKIE_PREFIX_HERE

# Protects GET /keep-alive. Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` automatically when
# this is set in the Vercel project; the GitHub keep-alive workflows send it from their CRON_SECRET secret.
# Without it, /keep-alive always answers 401. Generate one with: openssl rand -hex 32
CRON_SECRET=

NEXT_PUBLIC_SUPABASE_URL=NEXT_PUBLIC_SUPABASE_URL_HERE
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY_HERE

# ---------------------------------------------------------------------------
# Paid seminar videos. ALL of these are server-only secrets/settings:
# never prefix them with NEXT_PUBLIC_ and never copy them into the frontend repo.
# ---------------------------------------------------------------------------

# This backend's public URL (no trailing slash). Used to build the OAuth callback URLs,
# which must match exactly what is registered with Google/Yahoo.
# Production: https://cms.yoursite.com
# Local: your ngrok static domain (Yahoo requires https), started next to `pnpm dev` with
#   ngrok http --url=your-name.ngrok-free.app 3000
# An https SERVER_URL in development switches the customer cookie to SameSite=None; Secure
# so the frontend on http://localhost can use it. Plain http://localhost:3000 also works for Google only.
SERVER_URL=https://your-name.ngrok-free.app

# Local development only: ngrok agent authtoken (https://dashboard.ngrok.com/get-started/your-authtoken).
# `make tunnel` / `make up` read it from here. Leave it out of production.
NGROK_AUTHTOKEN=

# The public website (no trailing slash). Sign-in redirects back here; it is also the
# only browser origin allowed to call this API with cookies (CORS + CSRF).
# Production: https://yoursite.com   Local: the frontend's dev URL
FRONTEND_URL=http://localhost:3001

# Shared with the website (same value in its REVALIDATE_SECRET). Saving a seminar, legal page or
# company info calls ${FRONTEND_URL}/api/revalidate so the website updates right away.
# Without it, changes appear at the website's next periodic refresh. Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# Production only: parent domain for the customer session cookie so it works on both
# yoursite.com and cms.yoursite.com. Leave empty in local development.
COOKIE_DOMAIN=

# Google sign-in: Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yahoo sign-in: developer.yahoo.com → My Apps → your app (OpenID Connect permissions: Email, Profile).
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Mux signed playback: Mux dashboard → Settings → Signing Keys → Generate new key.
# ID of the signing key (not the API access token ID).
MUX_SIGNING_KEY_ID=
# The base64-encoded private key exactly as Mux shows it (shown only once at creation).
MUX_SIGNING_KEY_PRIVATE=
